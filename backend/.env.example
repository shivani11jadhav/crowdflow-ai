# ──────────────────────────────────────────────────────────────
# CrowdFlow AI — Backend Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.
# Add .env to your .gitignore immediately.

# ── Required ───────────────────────────────────────────────────

# Google Gemini API Key  (REQUIRED — server will not start without it)
# Obtain at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Server ─────────────────────────────────────────────────────

# Port the HTTP/WS server binds to (defaults to 3001)
PORT=3001

# ── Security ───────────────────────────────────────────────────

# CORS — set to your exact Netlify / production URL in production.
# For local development you may use http://localhost:3000.
# Using * disables origin checking and should ONLY be used during dev.
#
# Production example:  FRONTEND_ORIGIN=https://crowdflow-ai.netlify.app
# Local dev example:   FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# Node environment — controls whether internal error details are
# exposed in 502 responses.  Set to "production" on live servers.
NODE_ENV=development
